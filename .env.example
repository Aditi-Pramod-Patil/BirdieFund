# =============================================================================
# BIRDIEFUND — PRODUCTION ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to `.env` and fill in your credentials.
# For Vercel deployment, add each variable in: Project Settings → Environment Variables
#
# Variable Naming Convention:
#   VITE_* / NEXT_PUBLIC_* = Exposed to browser bundle (safe for public keys only)
#   No prefix              = Server-only (Vercel serverless functions in /api)
# =============================================================================

# Platform Identity
NEXT_PUBLIC_APP_NAME=BirdieFund
VITE_APP_NAME=BirdieFund
NEXT_PUBLIC_APP_URL=https://birdiefund.com
VITE_APP_URL=https://birdiefund.com

# -----------------------------------------------------------------------------
# 1. SUPABASE — Client-Side (Browser)
# Source: Supabase Dashboard → Settings → API → Project URL & anon/public key
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------------------------------------
# 2. SUPABASE — Server-Side (Vercel Functions Only)
# Source: Supabase Dashboard → Settings → API → service_role secret
# ⚠️ NEVER prefix with VITE_ — this key bypasses Row Level Security
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------------------------------------
# 3. STRIPE — Publishable Key (Browser)
# Source: Stripe Dashboard → Developers → API Keys → Publishable key
# -----------------------------------------------------------------------------
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_51...

# -----------------------------------------------------------------------------
# 4. STRIPE — Secret Keys (Vercel Functions Only)
# Source: Stripe Dashboard → Developers → API Keys → Secret key
# Source: Stripe Dashboard → Developers → Webhooks → Signing secret
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...

# -----------------------------------------------------------------------------
# 5. STRIPE — Subscription Price IDs
# Source: Stripe Dashboard → Products → Click product → Copy Price ID
# Create two products: Monthly ($24/mo) and Yearly ($220/yr)
# -----------------------------------------------------------------------------
STRIPE_PRICE_MONTHLY=price_1...
STRIPE_PRICE_YEARLY=price_1...

# -----------------------------------------------------------------------------
# 6. APPLICATION — Public URL
# Local development: http://localhost:5173
# Production: https://your-app.vercel.app (or your custom domain)
# Used for Stripe Checkout success/cancel redirect URLs
# -----------------------------------------------------------------------------
VITE_APP_URL=https://your-app.vercel.app
